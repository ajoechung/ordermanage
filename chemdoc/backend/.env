APP_DEBUG = true

[APP]
DEFAULT_TIMEZONE = Asia/Shanghai

[DATABASE]
TYPE = mysql
HOSTNAME = 127.0.0.1
DATABASE = chemdoc
USERNAME = root
PASSWORD = root
HOSTPORT = 3306
CHARSET = utf8mb4
PREFIX =
DEBUG = true

[LANG]
default_lang = zh-cn

[REDIS]
REDIS_HOST = 127.0.0.1
REDIS_PORT = 6379
REDIS_PASSWORD =
REDIS_SELECT = 0

[JWT]
JWT_SECRET = chemdoc_jwt_secret_key_2026_secure
JWT_EXPIRE = 7200
JWT_ALGO = HS256

[UPLOAD]
UPLOAD_PATH = uploads
MAX_FILE_SIZE = 10485760
ALLOWED_EXT = jpg,jpeg,png,gif,pdf,doc,docx,xls,xlsx

[CORS]
ALLOWED_ORIGINS = *
ALLOWED_METHODS = GET,POST,PUT,DELETE,OPTIONS
ALLOWED_HEADERS = Content-Type,Authorization,X-Requested-With
EXPOSE_HEADERS = Content-Length,Content-Type
MAX_AGE = 86400
