{
    "name": "chemdoc/backend",
    "description": "化工单据管理系统 - ThinkPHP 8.1后端",
    "type": "project",
    "keywords": [
        "thinkphp",
        "chemdoc",
        "crm"
    ],
    "license": "Apache-2.0",
    "require": {
        "php": ">=8.1.0",
        "topthink/framework": "^8.1",
        "topthink/think-orm": "^3.0",
        "topthink/think-multi-app": "^1.0",
        "firebase/php-jwt": "^6.10",
        "ext-fileinfo": "*",
        "ext-json": "*",
        "ext-pdo": "*"
    },
    "require-dev": {
        "symfony/var-dumper": "^6.4"
    },
    "autoload": {
        "psr-4": {
            "app\\": "app/"
        },
        "psr-0": {
            "": "extend/"
        }
    },
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true
    },
    "scripts": {
        "post-autoload-dump": [
            "@php think clear"
        ]
    },
    "minimum-stability": "stable",
    "extra": {
        "think": {
            "services": [],
            "config": {
                "database": true
            }
        }
    }
}
